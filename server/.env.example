NODE_ENV=development
API_PORT=4000
CLIENT_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://admin:admin@localhost:5432/demo?schema=public

# Chat / structured output (groq | openai)
AI_PROVIDER=groq
AI_API_KEY=your-groq-api-key
# AI_MODEL=llama-3.3-70b-versatile

# RAG embeddings (default: local sentence-transformers service)
# Start: cd embeddings && pip install -r requirements.txt && uvicorn main:app --port 8000
# Uses FastEmbed (ONNX) — not sentence-transformers / PyTorch
LOCAL_EMBEDDING_URL=http://localhost:8000
# LOCAL_EMBEDDING_TIMEOUT_MS=30000
# LOCAL_EMBEDDING_MAX_RETRIES=3
# AI_EMBEDDING_PROVIDER=local
# AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
# AI_EMBEDDING_DIMENSIONS=384

# Cloud fallbacks (local → OpenAI → Groq) when local service is down
AI_EMBEDDING_API_KEY=your-openai-api-key

# Optional fallback for chat when Groq fails
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_API_KEY=your-openai-api-key
# AI_FALLBACK_MODEL=gpt-4o-mini

# RAG chunking & retrieval
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=5
