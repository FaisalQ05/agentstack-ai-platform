NODE_ENV=development
API_PORT=4000
CLIENT_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://admin:admin@localhost:5432/demo?schema=public

# Chat / structured output (groq | openai)
AI_PROVIDER=groq
AI_API_KEY=your-groq-api-key
# AI_MODEL=llama-3.3-70b-versatile

# RAG embeddings — required when AI_PROVIDER=groq (Groq has no embedding API)
AI_EMBEDDING_API_KEY=your-openai-api-key
# AI_EMBEDDING_PROVIDER=openai
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=768

# Optional fallback for chat when Groq fails
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_API_KEY=your-openai-api-key
# AI_FALLBACK_MODEL=gpt-4o-mini

# RAG chunking & retrieval
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=5
